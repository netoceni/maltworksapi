{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maltworks-api-lab-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "APP_ORIGIN": "https://app-staging.maltworks.com.br",
    "ADMIN_ORIGIN": "https://admin-staging.maltworks.com.br",
    "SESSION_TTL_DAYS": "1",
    "TELEMETRY_PERSIST_INTERVAL_SECONDS": "180",
    "TELEMETRY_RETENTION_DAYS": "7"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime-lab-staging",
      "new_sqlite_classes": [
        "RealtimeHub"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maltworks-lab-staging",
      "database_id": "REPLACE_WITH_NEW_STAGING_D1_UUID",
      "migrations_dir": "migrations"
    }
  ]
}
