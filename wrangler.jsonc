{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maltworks-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "APP_ORIGIN": "https://app.maltworks.com.br",
    "ADMIN_ORIGIN": "https://admin.maltworks.com.br",
    "SESSION_TTL_DAYS": "30",
    "TELEMETRY_PERSIST_INTERVAL_SECONDS": "60",
    "SALES_EMAIL_FROM": "notificacoes@maltworks.com.br",
    "SALES_EMAIL_TO": "neto__ceni@hotmail.com",
    "NOTIFICATION_EMAIL_FROM": "notificacoes@maltworks.com.br"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["neto__ceni@hotmail.com"]
    }
  ],
  "r2_buckets": [
    { "binding": "FIRMWARE", "bucket_name": "maltworks-firmware" },
    { "binding": "BATCH_FILES", "bucket_name": "maltworks-batch-files" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "RealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1-realtime", "new_sqlite_classes": ["RealtimeHub"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maltworks-recovery-20261027",
      "database_id": "a1bf5a75-1bec-4437-92fa-64e69c3da081",
      "migrations_dir": "migrations"
    }
  ]
}
