{
  "name": "maltworks-cloud-api",
  "version": "5.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run test:core && npm run test:realtime",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create maltworks-production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:core": "vitest run --exclude test/realtime-online.integration.spec.ts",
    "test:realtime": "vitest run test/realtime-online.integration.spec.ts --maxWorkers=1 --no-isolate"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260813.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "zod": "4.6.6",
    "vite": "8.2.4"
  }
}
